# Copy this file to .env and fill in the keys you have. Leave unused ones blank.
# Free tiers: Google AI Studio (aistudio.google.com) and Groq (console.groq.com)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional (defaults shown)
DEFAULT_MODEL=
EMBEDDING_BACKEND=tfidf
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MIN_SCORE=
MAX_MEMORY_MESSAGES=20
GEMINI_THINKING_LEVEL=low
MAX_FALLBACKS=2
DATA_DIR=data
